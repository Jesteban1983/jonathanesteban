# ═══════════════════════════════════════════════════════════════════
# Configuración de entorno — jonathanesteban.dev
# Copia este archivo como .env y completa los valores
# ═══════════════════════════════════════════════════════════════════

# ── EMAIL (obligatorio al menos uno) ───────────────────────────────
# Proveedor principal: Resend (recomendado — 100 emails/día gratis)
# 1. Regístrate en https://resend.com
# 2. Ve a API Keys → Crea una key
# 3. (Opcional) Verifica tu dominio para enviar a cualquier email
RESEND_API_KEY=

# Para enviar desde tu dominio verificado (ej: "tu-dominio.com")
# Déjalo vacío para usar onboarding@resend.dev (solo te llegará a ti)
RESEND_DOMAIN=

# Proveedor alternativo: SendGrid (fallback automático si Resend falla)
# 1. Regístrate en https://sendgrid.com
# 2. Ve a Settings → API Keys → Create Key
# 3. Verifica un remitente (Single Sender Verification)
SENDGRID_API_KEY=

# Email remitente (opcional — por defecto se usa contacto@jonathanesteban.dev)
# SENDER_EMAIL_NO_REPLY=noreply@tudominio.com

# ── TELEGRAM (opcional — notificaciones instantáneas) ──────────────
# 1. Busca @BotFather en Telegram → /newbot → obtén el token
# 2. Busca @userinfobot → obtén tu chat_id numérico
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── N8N (opcional — webhook para automatizaciones) ─────────────────
# URL del webhook de n8n para recibir leads.
# PRODUCCIÓN (Netlify Functions, corren en la nube): usa la URL pública →
#   https://n8n.jonathanesteban.dev/webhook/recepcionista-leads
# LOCAL (netlify dev): usa localhost → http://localhost:5678/webhook/...
N8N_WEBHOOK_LEADS_URL=
# Secreto compartido para autenticar la llamada (header x-n8n-secret, mismo
# valor que se configura en el webhook de n8n)
N8N_WEBHOOK_SECRET=

# ── GOOGLE SHEETS / GOOGLE FORMS (envíos ilimitados gratuitos) ────
# Opción 1 (Recomendada): Google Apps Script conectado a una Google Sheet
# Ver guía de configuración en GOOGLE-SHEETS-SETUP.md
GOOGLE_SHEET_WEBHOOK_URL=
# Secreto opcional para validar que las peticiones vienen de tu sitio
GOOGLE_SHEET_SECRET=

# Opción 2: Google Form nativo headless (vía formResponse)
# GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/u/0/d/e/TU_FORM_ID/formResponse
# GOOGLE_FORM_ENTRY_NAME=entry.123456789
# GOOGLE_FORM_ENTRY_EMAIL=entry.234567890
# GOOGLE_FORM_ENTRY_SUBJECT=entry.345678901
# GOOGLE_FORM_ENTRY_MESSAGE=entry.456789012
# GOOGLE_FORM_ENTRY_WHATSAPP=entry.567890123

# ── REDES SOCIALES / OAUTH (opcional — para auth callbacks) ────────
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=