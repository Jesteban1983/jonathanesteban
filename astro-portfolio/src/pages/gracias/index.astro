---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="¡Gracias por tu Mensaje! | Jonathan Esteban · Soporte Informático" description="Mensaje recibido correctamente. Te responderé en menos de 24 horas.">
  <main class="container-narrow" style="padding-top: calc(var(--nav-height) + 4rem); padding-bottom: 4rem; text-align: center;">
    <div class="card fade-in">
      <h1 style="font-size: var(--fs-h2); color: var(--color-brand); margin-bottom: 1rem;">¡Mensaje recibido!</h1>
      <p style="font-size: 1.15rem; color: var(--color-text-muted); margin-bottom: 1.5rem;">Gracias por escribirme. He recibido tu mensaje correctamente y te responderé en menos de 24 horas.</p>
      
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem;">
        <a href="/" class="btn-primary">Volver al Inicio</a>
        <a href="/servicios/" class="btn-secondary">Ver Servicios</a>
      </div>
    </div>
  </main>
</Layout>