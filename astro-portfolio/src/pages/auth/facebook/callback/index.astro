---
import Layout from '../../../../layouts/Layout.astro';
---
<Layout title="Autenticación con Facebook | Jonathan Esteban" description="Página de callback para autenticación OAuth con Facebook." canonical="/auth/facebook/callback/">
  <meta http-equiv="refresh" content="0;url=/">

  <main id="main-content">
    <section class="hero-base" style="min-height: 60vh; display: flex; align-items: center; justify-content: center;">
      <div class="container" style="text-align: center;">
        <p style="font-size: 1.1rem; color: var(--color-text-muted);">Procesando autenticación con Facebook...</p>
      </div>
    </section>
  </main>

  <script>
    (async () => {
      try {
        const params = new URLSearchParams(window.location.search);
        const code = params.get('code');
        if (code) {
          const resp = await fetch(`/api/facebook-oauth-callback?code=${encodeURIComponent(code)}`);
          if (resp.ok) {
            const data = await resp.json();
            if (data.redirect) window.location.href = data.redirect;
          }
        }
      } catch (e) {
        console.error('Facebook OAuth error:', e);
      }
    })();
  </script>
</Layout>