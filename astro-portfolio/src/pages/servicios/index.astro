  <script>
(function(){
  var mapDiv = document.getElementById('coverage-map');
  if (!mapDiv) return;

  // Load Leaflet.js from local path (Astro strips <script src> tags)
  var s = document.createElement('script');
  s.src = '/leaflet/leaflet.js';
  document.head.appendChild(s);

  var waited = 0;
  function poll() {
    if (typeof L !== 'undefined') {
      try { doMap(); }
      catch(e) { console.log('Map init error:', e); }
      return;
    }
    if (++waited > 60) return;
    setTimeout(poll, 250);
  }
  setTimeout(poll, 600);

  function doMap() {
    var getTheme = function() {
      return document.documentElement.getAttribute('data-theme') || 'light';
    };
    var currentTheme = getTheme();

    var map = L.map(mapDiv, {
      center: [41.370, 2.125],
      zoom: 11,
      zoomControl: true,
      attributionControl: true,
      scrollWheelZoom: false
    });

    if (map.zoomControl) {
      map.zoomControl.setPosition('topright');
    }

    // High quality, 100% keyless street map from Esri ArcGIS (full detail, readable names in light & dark mode)
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 18,
      attribution: 'Tiles &copy; Esri'
    }).addTo(map);

    // 1. Dual-layered coverage radius (displacement zone)
    // Outer subtle boundary (~15.5 km)
    L.circle([41.368, 2.120], {
      radius: 15500,
      color: '#3FA9BD',
      weight: 1,
      fillColor: '#3FA9BD',
      fillOpacity: 0.04,
      dashArray: '3, 6',
      interactive: false
    }).addTo(map);

    // Core displacement zone (~12.5 km)
    var coverageCircle = L.circle([41.368, 2.120], {
      radius: 12500,
      color: '#3FA9BD',
      weight: 2,
      fillColor: '#3FA9BD',
      fillOpacity: 0.12,
      dashArray: '6, 6'
    }).addTo(map);

    coverageCircle.bindTooltip("Área metropolitana · Desplazamiento presencial incluido", {
      direction: 'center',
      className: 'map-circle-tooltip'
    });

    // 2. Animated Radar Beacon at Base (L'Hospitalet de Llobregat)
    var beaconIcon = L.divIcon({
      html: '<div class="beacon-wrapper"><div class="beacon-ripple"></div><div class="beacon-center"></div></div>',
      iconSize: [24, 24],
      iconAnchor: [12, 12],
      className: ''
    });

    var baseMarker = L.marker([41.360, 2.100], { icon: beaconIcon }).addTo(map);
    baseMarker.bindTooltip("<strong>Centro de Operaciones</strong><br>L'Hospitalet de Llobregat · Soporte a domicilio y remoto", {
      direction: 'top',
      offset: [0, -10]
    });

    // 3. Key Metropolitan Hubs
    var createCityDot = function(coords, name, desc) {
      var dotIcon = L.divIcon({
        html: '<div class="beacon-city-dot"></div>',
        iconSize: [10, 10],
        iconAnchor: [5, 5],
        className: ''
      });
      var marker = L.marker(coords, { icon: dotIcon }).addTo(map);
      marker.bindTooltip("<strong>" + name + "</strong><br>" + desc, {
        direction: 'top',
        offset: [0, -6]
      });
      return marker;
    };

    createCityDot([41.388, 2.170], "Barcelona", "Desplazamiento presencial incluido");
    createCityDot([41.356, 2.072], "Cornellà / Baix Llobregat", "Desplazamiento presencial incluido");
    createCityDot([41.442, 2.235], "Badalona / Barcelonès Nord", "Desplazamiento presencial incluido");

    // Fit view comfortably
    map.fitBounds(coverageCircle.getBounds(), { padding: [18, 18] });
  }
})();
</script>
