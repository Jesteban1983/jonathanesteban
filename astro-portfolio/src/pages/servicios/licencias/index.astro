---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Licencias Originales Low-Cost | Jonathan Esteban" description="Asesoría para encontrar licencias originales económicas de Windows, Office y software. Instalación y activación incluidas. Sin riesgos." canonical="/servicios/licencias/">
  <style is:global>
    .service-detail ul { list-style: none; padding: 0; }
    .service-detail li { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0.75rem; }
  </style>

  <main id="main-content">
    <section class="hero-base">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Miga de pan" style="margin-bottom: var(--space-2);">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <a href="/servicios/">Servicios</a>
          <span class="sep">/</span>
          <span class="current">Licencias</span>
        </nav>
        <p class="hero-eyebrow">Servicio</p>
        <div class="service-hero">
        <div>
        <h1 class="hero-title">Licencias Originales Low-Cost</h1>
        <p class="hero-lead" style="margin-bottom: 0;">Asesoría para encontrar licencias originales económicas de Windows, Office y otro software. Instalación y activación incluidas.</p>
        </div>
        <figure class="service-hero-img">
          <img src="/assets/img/servicios/licencias.jpg" alt="Disco de instalación de software junto a un ordenador" width="1000" height="750" fetchpriority="high" />
        </figure>
        </div>
      </div>
    </section>
    <div class="container">

      <section class="service-detail" style="margin-block: 2.5rem;">
        <h2 style="font-size: var(--fs-xl); font-weight: 700; margin-bottom: 1rem;">¿Qué incluye?</h2>
        <ul>
          <li>Asesoría para encontrar la licencia más económica</li>
          <li>Instalación y activación de Windows 10/11</li>
          <li>Instalación y activación de Microsoft Office</li>
          <li>Licencias para software específico</li>
          <li>Configuración de cuenta Microsoft</li>
        </ul>
      </section>

      <section class="service-detail" style="margin-block: 2.5rem;">
        <h2 style="font-size: var(--fs-xl); font-weight: 700; margin-bottom: 1rem;">Precios orientativos</h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.7;">Asesoría gratuita con cualquier otro servicio. Instalación y activación desde 20 € + coste de licencia. Te ayudo a encontrar opciones desde 10 €.</p>
      </section>

      <section class="cta-card">
        <h2 style="font-size: var(--fs-xl); font-weight: 700; margin-bottom: 0.75rem;">¿Necesitas este servicio?</h2>
        <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">Contáctame sin compromiso y te preparo un presupuesto.</p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
          <a href="/contacto/" class="btn-primary">Solicitar presupuesto</a>
          <a href="https://wa.me/34614739345" class="btn-contact whatsapp-btn" target="_blank">WhatsApp</a>
        </div>
      </section>
    </div>
  </main>
</Layout>