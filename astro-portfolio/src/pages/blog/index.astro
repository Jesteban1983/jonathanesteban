---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  canonical="/blog/"
  title="Blog de Soporte Informático: Guías Prácticas | Barcelona"
  description="Guías claras sobre PC lento, Wi-Fi, discos duros, redes y ofimática para particulares y pymes de Barcelona, escritas por un técnico informático en activo."
>
  <main id="main-content" class="container-wide" style="padding-block: 6rem 4rem;">
    <header class="blog-index-header">
      <img src="/assets/img/brand/logo-horizontal-descriptor.svg" alt="Jonathan Esteban — Soporte Informático en Barcelona" class="blog-index-logo" height="48" width="280">
      <h1 class="blog-index-title">Blog</h1>
      <p class="blog-index-desc">Consejos prácticos sobre soporte informático, mantenimiento de equipos, redes, ofimática y tecnología aplicada a pymes y particulares.</p>
    </header>

    <div class="blog-grid">
      {
        posts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.id}/`} class="blog-card-link">
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt={post.data.title} class="blog-card-img" loading="lazy" width="600" height="315" />
              )}
              <div class="blog-card-body">
                <time datetime={post.data.pubDate.toISOString()} class="blog-card-date">
                  {new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate)}
                </time>
                <h2 class="blog-card-title">{post.data.title}</h2>
                <p class="blog-card-desc">{post.data.description}</p>
                <div class="blog-card-tags">
                  {post.data.tags.map((tag) => <span class="blog-tag">{tag}</span>)}
                </div>
                <span class="blog-card-read">Leer artículo →</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .blog-index-header { margin-bottom: 4rem; text-align: center; }
  .blog-index-logo { display: block; margin: 0 auto 2rem; max-width: 280px; height: auto; }
  .blog-index-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    margin-bottom: 1rem;
    text-align: center;
  }
  .blog-index-desc {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: 4rem;
    font-size: var(--fs-lg);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }
  .blog-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .blog-card:hover { border-color: var(--color-primary-hover); }
  .blog-card-link { display: block; text-decoration: none; color: inherit; }
  .blog-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .blog-card-body { padding: 1.5rem; }
  .blog-card-date {
    display: block;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .blog-card-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    text-align: left;
  }
  .blog-card-desc {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
    text-align: justify;
    text-justify: inter-word;
  }
  .blog-card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .blog-tag {
    display: inline-block;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-surface-offset);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .blog-card-read {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent);
  }
  @media (max-width: 480px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>