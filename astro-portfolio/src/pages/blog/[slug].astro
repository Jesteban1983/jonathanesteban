---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | Jonathan Esteban — Soporte Informático`}
  description={post.data.description}
  image={post.data.heroImage}
  canonical={`https://jonathanesteban.dev/blog/${post.slug}/`}
>
  <main class="container-wide" style="padding-block: 6rem 4rem;">
    <article class="blog-post">
      <header class="blog-post-header">
        <a href="/blog/" class="blog-post-back">← Volver al blog</a>
        <h1 class="blog-post-title">{post.data.title}</h1>
        <div class="blog-post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <span class="blog-post-updated">
              (Actualizado: {new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.updatedDate)})
            </span>
          )}
          <span class="blog-post-author">por {post.data.author}</span>
        </div>
        {post.data.heroImage && (
          <img src={post.data.heroImage} alt="" class="blog-post-hero" />
        )}
      </header>

      <div class="blog-post-content">
        <Content />
      </div>

      <footer class="blog-post-footer">
        <hr class="blog-post-hr">
        <div class="blog-post-author-bio">
          <img src="/brand/logo-icono.svg" alt="" class="author-avatar" width="48" height="48">
          <div>
            <strong>Jonathan Esteban</strong> — técnico de soporte informático en Barcelona.
            Llevo desde 2006 en el mundo de la informática y atiendo a particulares y pymes
            de forma directa, sin intermediarios ni call centers.
            <a href="/sobre-mi/">Más sobre mí →</a>
          </div>
        </div>
        <p class="blog-post-cta">
          ¿Te ha gustado el artículo? Si necesitas ayuda con tu equipo o tu red,
          <a href="/contacto/">pídeme presupuesto sin compromiso</a>.
          Incluye 15 días de garantía desde la entrega.
        </p>
      </footer>
    </article>
  </main>
</Layout>

<style>
  .blog-post {
    max-width: var(--content-wide);
    margin-inline: auto;
    font-family: inherit;
    font-size: inherit;
    line-height: 1.75;
    color: inherit;
  }
  .blog-post-back {
    display: inline-block;
    font-size: var(--fs-base);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    color: var(--color-accent);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .blog-post-back:hover { text-decoration: underline; }
  .blog-post-title {
    font-size: var(--fs-h1);
    font-weight: 800;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    line-height: 1.15;
    margin-bottom: 1rem;
    text-align: justify;
  }
  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: var(--fs-base);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .blog-post-author { font-weight: 500; color: var(--color-text-secondary); }
  .blog-post-hero {
    width: 100%;
    max-width: min(100%, 720px);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    margin-inline: auto;
    margin-bottom: 1.5rem;
  }
  .blog-post-content {
    font-size: var(--fs-base);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    line-height: 1.9;
    color: var(--color-text-main);
    hyphens: auto;
    text-align: justify;
    text-justify: inter-word;
  }
  /* Aplicar justificación explícita al texto completo del artículo,
     incluidos párrafos dentro de listas, celdas y nota de la tabla. */
  .blog-post-content p,
  .blog-post-content li,
  .blog-post-content td,
  .blog-post-content :global(.apa-note) {
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow-wrap: break-word;
  }
  .blog-post-content :global(.apa-table tbody td) {
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  /* Espaciado entre párrafos y puntos */
  .blog-post-content p            { margin: 0 0 1.25em; }
  .blog-post-content :where(ul, ol) { margin: 0 0 1.5em; padding-left: 1.5em; }
  .blog-post-content li           { margin: 0 0 .6em; }
  .blog-post-content li > :where(ul, ol) { margin: .6em 0 0; }
  .blog-post-content li:last-child { margin-bottom: 0; }
  /* H2 del MDX: 1 px sobre el cuerpo, negrita y una línea de aire superior. */
  .blog-post-content :global(h2) {
    display: block;
    box-sizing: border-box;
    margin: 1.9em 0 .75em;
    padding: 0 0 0 1rem;
    border: 0;
    border-left: 4px solid var(--color-accent, #F2A72A);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: calc(var(--fs-base) + 1px);
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
  }
  .blog-post-content h3 {
    font-size: var(--fs-h3);
    font-weight: 600;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    text-align: left;
    margin: 1.75em 0 .6em;
  }
  .blog-post-content h4 {
    font-size: var(--fs-base);
    font-weight: 600;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    text-align: left;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .blog-post-content strong { font-weight: 600; color: var(--color-text-secondary); }
  .blog-post-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-post-hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: 3rem;
  }
  .blog-post-author-bio {
    display: flex;
    gap: 1rem;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .author-avatar { flex-shrink: 0; border-radius: 50%; }
  .blog-post-author-bio strong { color: var(--color-text-main); }
  .blog-post-author-bio a { color: var(--color-accent); font-weight: 600; white-space: nowrap; }
  .blog-post-cta {
    text-align: center;
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .blog-post-cta a {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>