---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Contacto y Presupuesto de Soporte Informático | Barcelona" description="Pide presupuesto sin compromiso para reparar tu ordenador, configurar tu red o instalar Windows. Respuesta en menos de 24 h laborables en L'Hospitalet y Barcelona." canonical="/contacto/">
  <main id="main-content">
    <section class="hero-base">
      <div class="container">
        <div class="fade-in">
          <p class="hero-eyebrow">Hablemos de tu incidencia</p>
          <h1 class="hero-title">Contacto</h1>
          <p class="hero-lead" style="margin-bottom: 0; white-space: nowrap; max-width: none;">Descríbeme tu problema o consulta. Respondo habitualmente en menos de 24 horas.</p>
        </div>
      </div>
    </section>

    <div class="container contact-grid">
      <div class="contact-form-card fade-in">
        <div class="form-shell-head">
          <div class="form-shell-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span class="form-shell-title">./soporte.sh</span>
          <span class="form-shell-status">Respuesta &lt; 24h</span>
        </div>
        <form id="contactForm" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="_gotcha" novalidate aria-describedby="formError">
          <input type="hidden" name="form-name" value="contact" />
          <input type="text" name="_gotcha" style="display:none;" aria-hidden="true" tabindex="-1">
          <input type="text" name="company_site" style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true" tabindex="-1" autocomplete="off">

          <div class="form-row form-row-3">
            <div class="form-group">
              <label for="name">Nombre Completo <span class="label-accent">*</span></label>
              <input type="text" id="name" name="name" class="form-control" placeholder="Tu nombre y apellidos" required autocomplete="name">
            </div>

            <div class="form-group">
              <label for="email">Correo Electrónico <span class="label-accent">*</span></label>
              <input type="email" id="email" name="email" class="form-control" placeholder="tu@email.com" required autocomplete="email" inputmode="email">
            </div>

            <div class="form-group">
              <label for="subject">Asunto del Servicio</label>
              <select id="subject" name="subject" class="form-control">
                <option value="">Selecciona un servicio...</option>
                <option value="Helpdesk N1">Soporte Helpdesk N1</option>
                <option value="Mantenimiento PC">Mantenimiento y Reparación de PC</option>
                <option value="Instalación Sistemas">Instalación de Sistemas</option>
                <option value="Redes">Diagnóstico y Configuración de Redes</option>
                <option value="Ofimática">Soporte Ofimático y Migración</option>
                <option value="Licencias">Licencias Originales</option>
                <option value="Otro">Otro / No lo sé</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="message">Describe tu incidencia o consulta <span class="label-accent">*</span></label>
            <textarea id="message" name="message" class="form-control" placeholder="¿Qué te está pasando? ¿Desde cuándo? ¿Qué equipo tienes? Cuanto más detalle, mejor." required></textarea>
          </div>

          <div class="form-checkbox-group">
            <label class="form-checkbox">
              <input type="checkbox" id="consentReply" required>
              <span>He leído y acepto la <a href="/privacy-policy/" target="_blank">Política de Privacidad</a> <span class="label-accent">*</span></span>
            </label>
            <label class="form-checkbox">
              <input type="checkbox" id="consentWhatsapp">
              <span>Acepto que me contacten vía WhatsApp si es necesario</span>
            </label>
          </div>

          <button type="submit" class="btn-primary form-submit">
            Enviar mensaje
          </button>

          <div id="formError" class="form-error" role="alert" aria-live="assertive"></div>
          <div id="formSuccess" class="form-success" role="status" aria-live="polite">✓ ¡Mensaje enviado con éxito! Te responderé en breve.</div>
        </form>
      </div>
    </div>
    <div style="height: 3rem;"></div>
  </main>

  <style>
    /* En la página de contacto acercamos el form al hero para un
       espacio de interlineado cómodo (el resto del sitio usa 3rem). */
    .hero-base { padding-bottom: 1.5rem; }
  </style>

  <!-- Formspree incluye protección anti-bots automática (reCAPTCHA v3 del lado servidor) -->
  <script>
    // Contact form handling
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contactForm');
      if (!form) return;

      const errorDiv = document.getElementById('formError');
      const successDiv = document.getElementById('formSuccess');
      const submitBtn = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorDiv.style.display = 'none';
        successDiv.style.display = 'none';

        // Validate required fields
        const name = form.querySelector('#name').value.trim();
        const email = form.querySelector('#email').value.trim();
        const message = form.querySelector('#message').value.trim();
        const consent = form.querySelector('#consentReply').checked;

        if (!name || !email || !message || !consent) {
          errorDiv.textContent = 'Completa todos los campos obligatorios (*).';
          errorDiv.style.display = 'block';
          return;
        }

        // Email validation
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          errorDiv.textContent = 'Introduce un correo electrónico válido.';
          errorDiv.style.display = 'block';
          return;
        }

        // Loading state
        submitBtn.classList.add('loading');
        submitBtn.textContent = 'Enviando...';

        // ── Envío al recepcionista AI (Netlify Function) con fallback a Formspree ──
        // El proxy valida (honeypot + rate-limit) y reenvía a n8n. Si el
        // proxy no responde (o no está desplegado aún), caemos a Formspree
        // para no perder el mensaje: la producción nunca se rompe.
        let res = await proxyFetch(new FormData(form));

        if (res && res.ok) {
          form.reset();
          const targetUrl = '/gracias/?email=' + encodeURIComponent(email) + '&name=' + encodeURIComponent(name);
          window.location.href = targetUrl;
          return;
        } else {
          errorDiv.textContent = 'Error al enviar el mensaje. Inténtalo de nuevo.';
          errorDiv.style.display = 'block';
          submitBtn.classList.remove('loading');
          submitBtn.textContent = 'Enviar mensaje';
        }
      });

      // Intenta primero el endpoint del recepcionista; si falla, fallback a Netlify Forms nativo.
      async function proxyFetch(formData) {
        // 1. Endpoint principal (contact-recepcionista serverless function)
        try {
          const p = await fetch('/.netlify/functions/contact-recepcionista', {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });
          if (p.ok) {
            const data = await p.json().catch(() => ({}));
            if (data.ok) return { ok: true, source: 'recepcionista' };
          }
        } catch (err) {
          console.warn('[Form] Endpoint recepcionista no disponible:', err);
        }

        // 2. Fallback: Netlify Forms nativo (Edge)
        try {
          const bodyParams = new URLSearchParams();
          for (const [key, val] of formData.entries()) {
            bodyParams.append(key, String(val));
          }
          if (!bodyParams.has('form-name')) bodyParams.append('form-name', 'contact');

          const f = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: bodyParams.toString()
          });
          if (f.ok) return { ok: true, source: 'netlify-forms' };
        } catch (err) {
          console.warn('[Form] Fallback Netlify Forms no disponible:', err);
        }

        // 3. Entorno local de desarrollo o Tailscale sin serverless
        const isLocalDev = ['localhost', '127.0.0.1'].includes(window.location.hostname) ||
                           window.location.hostname.startsWith('100.') ||
                           window.location.port === '4321';
        if (isLocalDev) {
          console.info('🧪 [Dev local] Envío simulado con éxito para pruebas:', Object.fromEntries(formData));
          return { ok: true, source: 'dev' };
        }

        return { ok: false };
      }

      // Field focus/blur effects for validation feedback
      form.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('blur', () => {
          if (input.hasAttribute('required') && !input.value.trim()) {
            input.classList.add('error');
            input.setAttribute('aria-invalid', 'true');
          } else {
            input.classList.remove('error');
            input.removeAttribute('aria-invalid');
          }
        });
        input.addEventListener('input', () => { input.classList.remove('error'); input.removeAttribute('aria-invalid'); });
      });
    });
  </script>
</Layout>