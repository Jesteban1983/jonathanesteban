              </a>
              <a href="#cat-seguridad" class="faq-sidebar-link">
                <Icon name="shield" size={16} />
                <span>Datos y Licencias</span>
              </a>
            </nav>
          </aside>

          <!-- Listado de Preguntas por Categoría -->
          <div class="faq-content-main">
            
            <!-- CATEGORÍA 1: Servicios y Reparaciones Frecuentes -->
            <div class="faq-category-block" id="cat-servicios">
              <span class="faq-category-badge">
                <Icon name="wrench" size={16} />
                Hardware, Redes y Sistemas
              </span>
