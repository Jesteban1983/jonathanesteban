            <span class="hero-eyebrow-dot"></span>
            DUDAS HABITUALES
          </p>
          <h1 class="hero-title">Preguntas Frecuentes</h1>
          <p class="hero-lead">
            Todo lo que necesitas saber sobre mis servicios, reparaciones, hardware, redes, garantías y asistencia remota antes de contratar.
          </p>

          <!-- Buscador en tiempo real -->
          <div class="faq-search-box">
            <svg class="faq-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="text"
              id="faqSearchInput"
              class="faq-search-input"
              placeholder="Buscar por servicio o duda (ej. ssd, sobrecalentamiento, wifi, windows 11, garantía...)"
              aria-label="Buscar en preguntas frecuentes"
            />
            <p id="faqSearchCounter" class="faq-search-counter" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CUERPO DE PREGUNTAS Y RESPUESTAS ===== -->
    <section class="section" style="padding-top: 1rem;">
      <div class="container-wide fade-in">
        <div class="faq-layout-grid">
          
          <!-- Navegación Rápida Lateral -->
          <aside class="faq-sidebar">
            <nav class="faq-sidebar-sticky" aria-label="Navegación de preguntas frecuentes">
              <span class="faq-sidebar-title">Temas y Servicios</span>
              <a href="#cat-servicios" class="faq-sidebar-link active">
                <Icon name="wrench" size={16} />
                <span>Servicios y Averías</span>
              </a>
              <a href="#cat-presupuestos" class="faq-sidebar-link">
                <Icon name="file" size={16} />
                <span>Presupuestos y Garantía</span>
              </a>
              <a href="#cat-desplazamiento" class="faq-sidebar-link">
                <Icon name="pin" size={16} />
