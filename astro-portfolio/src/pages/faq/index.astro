  <script is:inline>
    // Buscador interactivo de preguntas y respuestas con filtrado dinámico
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('faqSearchInput');
      const counterEl = document.getElementById('faqSearchCounter');
      const noResultsEl = document.getElementById('faqNoResults');
      const allItems = Array.from(document.querySelectorAll('.faq-details-item'));
      const categoryBlocks = Array.from(document.querySelectorAll('.faq-category-block'));

      if (!searchInput) return;

      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        
        if (!query) {
          allItems.forEach(item => {
            item.style.display = '';
            // Restaurar estado inicial cerrado salvo el primero
          });
          categoryBlocks.forEach(block => block.style.display = '');
          if (noResultsEl) noResultsEl.style.display = 'none';
          if (counterEl) counterEl.textContent = '';
          return;
        }

        let visibleCount = 0;

        categoryBlocks.forEach(block => {
          const itemsInBlock = Array.from(block.querySelectorAll('.faq-details-item'));
          let blockHasVisible = false;

          itemsInBlock.forEach(item => {
            const summaryText = item.querySelector('summary')?.textContent.toLowerCase() || '';
            const contentText = item.querySelector('.faq-content')?.textContent.toLowerCase() || '';
            const matches = summaryText.includes(query) || contentText.includes(query);

            if (matches) {
              item.style.display = '';
              item.open = true;
              blockHasVisible = true;
              visibleCount++;
            } else {
              item.style.display = 'none';
              item.open = false;
            }
          });

          block.style.display = blockHasVisible ? '' : 'none';
        });

        if (noResultsEl) {
          noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
        }
        if (counterEl) {
          counterEl.textContent = visibleCount === 1 ? '1 pregunta encontrada' : `${visibleCount} preguntas encontradas`;
        }
      });
    });
  </script>
