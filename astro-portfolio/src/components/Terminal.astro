---
// Terminal interactivo — hero code typing with tab switching
---

<div id="heroTerminal">
  <div class="terminal-tabs">
    <button class="terminal-tab active" data-terminal-tab="python">Python</button>
    <button class="terminal-tab" data-terminal-tab="typescript">TypeScript</button>
    <button class="terminal-tab" data-terminal-tab="sql">SQL</button>
  </div>
  <div class="terminal-body">
    <div class="terminal-code" data-terminal-code></div>
  </div>
  <div class="terminal-statusbar">
    <span class="terminal-status-item">
      <span class="terminal-status-dot"></span> Live Session
    </span>
    <span class="terminal-status-item" data-terminal-status>Python 3.12.2</span>
    <span class="terminal-status-spacer"></span>
    <span class="terminal-status-item">FastAPI + n8n MCP • 99.9% uptime</span>
  </div>
</div>