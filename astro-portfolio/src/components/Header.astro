---
// Header component — desktop nav with dropdown + mobile hamburger menu
---

<header class="nav-header">
  <nav class="nav-inner">
    <!-- Logo: versión clara (dark bg) y oscura (light bg) -->
    <a href="/" class="nav-brand" aria-label="Jonathan Esteban — Ir al inicio">
      <img src="/brand/logo-horizontal.svg" alt="Jonathan Esteban" class="logo-light-theme" height="36">
      <img src="/brand/logo-horizontal-blanco.svg" alt="Jonathan Esteban" class="logo-dark-theme" height="36">
    </a>

    <!-- Desktop Nav -->
    <ul class="nav-links">
      <li><a href="/">Inicio</a></li>
      <li class="nav-item-dropdown">
        <a href="/servicios/">Servicios</a>
        <div class="dropdown-menu">
